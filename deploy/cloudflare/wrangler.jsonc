{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vozen-site",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "vozen.org/*", "zone_name": "vozen.org" },
    { "pattern": "www.vozen.org/*", "zone_name": "vozen.org" }
  ],
  "assets": {
    "directory": "../../.pages-artifact",
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {
      "name": "vozen-site-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "directory": "../../.pages-artifact",
        "not_found_handling": "404-page"
      }
    }
  }
}
